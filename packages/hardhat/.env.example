# Deployer / operator key (ECDSA, hex with or without 0x prefix). Never commit.
HEDERA_OPERATOR_KEY=
# Second key used as the buyer in the demo script (must differ from the seller key).
BUYER_KEY=
# Pyth receiver on Hedera testnet. Defaults to the documented address if unset.
PYTH_CONTRACT=0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
# HBAR/USD Pyth feed id (bytes32 hex). Fetch via:
# curl -s "https://hermes.pyth.network/v2/price_feeds?query=HBAR" | jq '.[].id'
PRICE_FEED_ID=
# Optional HTS precompile override. Leave unset to use 0x167.
HTS_PRECOMPILE=
# Deployed escrow (or packages/hardhat/deployed/<network>.json is read instead).
CONTRACT_ADDRESS=
# Fresh Hermes price-update bytes (hex) for pay(). Fetch via:
# curl -s "https://hermes.pyth.network/v2/updates/price/latest?ids[]=$PRICE_FEED_ID&encoding=hex" | jq -r '.binary.data[0]'
PRICE_UPDATE_HEX=
# ...or a file containing those hex bytes.
PRICE_UPDATE_FILE=
